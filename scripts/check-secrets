#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

for command in gitleaks sops; do
  if ! command -v "$command" >/dev/null 2>&1; then
    printf 'Required command is not installed: %s\n' "$command" >&2
    exit 1
  fi
done

if [[ -e .gitleaks.toml || -e .gitleaksignore ]]; then
  printf 'Unreviewed Gitleaks configuration can weaken secret detection.\n' >&2
  exit 1
fi

unset GITLEAKS_CONFIG GITLEAKS_CONFIG_TOML

printf 'Scanning Git history for secrets...\n'
gitleaks git --redact=100 --no-banner --ignore-gitleaks-allow --log-opts="--all" .

printf 'Scanning the working tree for secrets...\n'
gitleaks dir --redact=100 --no-banner --ignore-gitleaks-allow .

printf 'Verifying repository SOPS files...\n'
encrypted_count=0
shopt -s dotglob globstar nullglob
for file in encrypted/**/*; do
  if [[ -d "$file" ]]; then
    continue
  fi
  if [[ -L "$file" || ! -f "$file" ]]; then
    printf 'Unsupported entry under encrypted/: %s\n' "$file" >&2
    exit 1
  fi

  encrypted_count=$((encrypted_count + 1))
  status="$(sops filestatus --input-type binary "$file")"
  if [[ "$status" != '{"encrypted":true}' ]]; then
    printf 'Repository file is not SOPS-encrypted: %s\n' "$file" >&2
    exit 1
  fi
done

if ((encrypted_count == 0)); then
  printf 'No tracked files found under encrypted/.\n' >&2
  exit 1
fi

printf 'Secret checks passed; verified %d SOPS file(s).\n' "$encrypted_count"
